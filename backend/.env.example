# ---- App ----
APP_NAME=MentorLMS
DEBUG=true
ENVIRONMENT=development

# ---- Database ----
POSTGRES_USER=mentor
POSTGRES_PASSWORD=mentor_secret
POSTGRES_DB=mentor_lms
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://mentor:mentor_secret@localhost:5432/mentor_lms

# ---- Auth / JWT ----
SECRET_KEY=change-me-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- AI (OpenAI) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ---- S3 / File Storage ----
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# ---- CORS ----
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
